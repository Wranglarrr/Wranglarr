{
  "wranglarr": "wranglarr-config/1",
  "name": "Anime, English dub only",
  "description": "Only takes anime releases with an English audio track: marked dubbed, English audio, dual audio, multi audio or JA+EN, or from a group that releases English dubs (Golumpa, KaiDubs, KamiFS, KS, torenter69, Yameii). Subtitles don't count: Dual-Subs, Multi-Sub and Eng-Subs score nothing. A release that names another audio language and not English (PT-BR, Dublado, Latino, Castellano, VF, German DL, ITA-JAP, Hindi, German Dubbed…) scores -1000, even when it says dual audio. The profile needs 100, so subtitle-only releases are skipped. Set each show to series type Anime and this profile. Sonarr only; for films, copy the three custom formats to Radarr with the same scores.",
  "author": "wranglarr",
  "apps": {
    "sonarr": {
      "customFormats": [
        {
          "name": "English audio",
          "includeCustomFormatWhenRenaming": false,
          "specifications": [
            {
              "name": "Dubbed",
              "implementation": "ReleaseTitleSpecification",
              "negate": false,
              "required": false,
              "fields": {
                "value": "(?<![a-z0-9])(dub(bed|s)?|eng(lish)?[ ._-]?(dub(bed)?|audio)|funi[ ._-]?dub)(?![a-z0-9])"
              }
            },
            {
              "name": "Dual audio",
              "implementation": "ReleaseTitleSpecification",
              "negate": false,
              "required": false,
              "fields": {
                "value": "(?<![a-z0-9])dual[ ._-]?audio(?![a-z0-9])|[(\\[]dual[)\\]]|(?<![a-z0-9])(JA|JP|JPN|JAP|Japanese)[ ._+&/,-]+(EN|ENG|English)(?![a-z0-9]|[ ._-]?sub)|(?<![a-z0-9])(EN|ENG|English)[ ._+&/,-]+(JA|JP|JPN|JAP|Japanese)(?![a-z0-9])"
              }
            },
            {
              "name": "DUAL after the source",
              "implementation": "ReleaseTitleSpecification",
              "negate": false,
              "required": false,
              "fields": {
                "value": "(?<![a-z0-9])(2160p|1080p|720p|576p|480p|WEB-?DL|WEB-?Rip|WEB|BluRay|BDRip|BD|HDTV|DVDRip)(?![a-z0-9]).*(?<![a-z0-9])DUAL(?![a-z0-9]|[ ._-]?sub)"
              }
            },
            {
              "name": "Multi audio",
              "implementation": "ReleaseTitleSpecification",
              "negate": false,
              "required": false,
              "fields": {
                "value": "(?<![a-z0-9])multi[ ._-]?(audio|lang(uage)?s?)(?![a-z0-9])|[(\\[]multi[)\\]]|(?<![a-z0-9])(2160p|1080p|720p|576p|480p|WEB-?DL|WEB-?Rip|WEB|BluRay|BDRip|BD|HDTV|DVDRip)(?![a-z0-9]).*(?<![a-z0-9])MULTI(?![a-z0-9]|[ ._-]?sub)"
              }
            }
          ]
        },
        {
          "name": "English dub groups",
          "includeCustomFormatWhenRenaming": false,
          "specifications": [
            {
              "name": "Dub groups",
              "implementation": "ReleaseGroupSpecification",
              "negate": false,
              "required": false,
              "fields": {
                "value": "^(Golumpa|KaiDubs|KamiFS|KS|torenter69|Yameii)$"
              }
            }
          ]
        },
        {
          "name": "Other-language audio",
          "includeCustomFormatWhenRenaming": false,
          "specifications": [
            {
              "name": "Another audio language",
              "implementation": "ReleaseTitleSpecification",
              "negate": false,
              "required": true,
              "fields": {
                "value": "(?<![a-z0-9])(ger(man)?|ita(lian)?|spa(nish)?|esp|fre(nch)?|fra|por(tuguese)?|rus(sian)?|hin(di)?|tam(il)?|tel(ugu)?|kor(ean)?|ara(bic)?|pol(ish)?|tur(kish)?|chi(nese)?|mandarin|cantonese)[ ._-]?(dub(bed)?|audio)(?![a-z0-9])|(?<![a-z0-9])(dublado|dublagem|doblado|doblaje|latino|castellano|VF|VFF|VFQ|VF2|TRUEFRENCH|PT[ ._-]?BR|MVO|DVO|AVO|hindi|tamil|telugu|malayalam|kannada|bengali)(?![a-z0-9])|(?<![a-z0-9])(german|ger)[ ._-]DL(?![a-z0-9])|(?<![a-z0-9])(ITA|SPA|ESP|FRE|FRA|GER|POR|RUS)[ ._+&/,-]+(JA|JP|JPN|JAP|Japanese)(?![a-z0-9])|(?<![a-z0-9])(JA|JP|JPN|JAP|Japanese)[ ._+&/,-]+(ITA|SPA|ESP|FRE|FRA|GER|POR|RUS)(?![a-z0-9])"
              }
            },
            {
              "name": "English isn't named",
              "implementation": "ReleaseTitleSpecification",
              "negate": true,
              "required": true,
              "fields": {
                "value": "(?<![a-z0-9])(eng|english)(?![a-z0-9]|[ ._-]?sub)|(?<![a-z0-9])(JA|JP|JPN|JAP|Japanese)[ ._+&/,-]+EN(?![a-z0-9]|[ ._-]?sub)|(?<![a-z0-9])EN[ ._+&/,-]+(JA|JP|JPN|JAP|Japanese)(?![a-z0-9])"
              }
            }
          ]
        }
      ],
      "qualityProfiles": [
        {
          "name": "Anime, English dub",
          "upgradeAllowed": true,
          "cutoff": "1080p",
          "qualities": [
            {
              "name": "1080p",
              "qualities": [
                "Bluray-1080p",
                "WEBDL-1080p",
                "WEBRip-1080p",
                "HDTV-1080p"
              ]
            },
            {
              "name": "720p",
              "qualities": [
                "Bluray-720p",
                "WEBDL-720p",
                "WEBRip-720p",
                "HDTV-720p"
              ]
            }
          ],
          "minFormatScore": 100,
          "cutoffFormatScore": 100,
          "minUpgradeFormatScore": 1,
          "formatScores": {
            "English audio": 100,
            "English dub groups": 100,
            "Other-language audio": -1000
          }
        }
      ]
    }
  }
}
