# ---------------------------------------------------------------------------
# Copy to .env and edit.  compose.yaml, compose.init.yaml, compose.vpn.yaml and
# scripts/init.sh all read from here.
# ---------------------------------------------------------------------------

TZ=America/Chicago
PUID=1000
PGID=1000
UMASK=002

# wranglarr's image: the published one, or wranglarr:local for one you built
# (docker build -t wranglarr:local ./wranglarr; wiki/Setup.md, "The wranglarr image")
WRANGLARR_IMAGE=ghcr.io/wranglarrr/wranglarr:latest
# Development track: ghcr.io/wranglarrr/wranglarr:edge (every tested main build).
# Keep this image consistent with the track selected on the Updates page.

# ---------------------------------------------------------------------------
# Which services to run (opt-in).  Remove any you don't want.
# postgres and wranglarr always run.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=radarr,sonarr,lidarr,prowlarr,bazarr,qbittorrent
# available: radarr sonarr lidarr prowlarr bazarr qbittorrent sabnzbd nzbget seerr

# VPN: uncomment one to route apps through one shared WireGuard tunnel
# (gluetun), configured in the VPN section below (wiki/VPN-Shared-Tunnel.md):
#COMPOSE_FILE=compose.yaml:compose.vpn.yaml:compose.vpn-all.yaml        # every app
#COMPOSE_FILE=compose.yaml:compose.vpn.yaml:compose.vpn-prowlarr.yaml   # download clients + Prowlarr
#COMPOSE_FILE=compose.yaml:compose.vpn.yaml                             # download clients only

# Where container config/appdata lives (per-app config, Postgres cluster,
# wranglarr state, backup versions).  Relative paths are relative to this dir.
APPDATA=./appdata

# ---------------------------------------------------------------------------
# Data drives
# ---------------------------------------------------------------------------
# Every app gets ONE bind mount at /data so hardlinks and atomic moves work
# between downloads and the library (two mounts of the same filesystem break
# hardlinking).  Layout:
#   ${DATA_ROOT}/torrents/<arr>          qBittorrent, one category per arr
#   ${DATA_ROOT}/usenet/complete/<arr>   SABnzbd / NZBGet, one category per arr
#   ${DATA_ROOT}/usenet/incomplete
#   ${DATA_ROOT}/media/movies    -> Radarr root folder  /data/media/movies
#   ${DATA_ROOT}/media/tv        -> Sonarr root folder  /data/media/tv
#   ${DATA_ROOT}/media/music     -> Lidarr root folder  /data/media/music
DATA_ROOT=/mnt/data
# Optional second drive -> /data2 (uncomment the matching lines in compose.yaml).
DATA_ROOT_2=

# Where the download clients save, as seen inside the containers.  init.sh
# writes these into the clients' configs (only while those are still at their
# defaults) and creates the folders; wranglarr adds the clients to every arr
# with the arr's name as category.  Keep them under /data.
#TORRENTS_DIR=/data/torrents
#USENET_DIR=/data/usenet
# SABnzbd keeps a copy of every NZB here (relative to its /config), so a
# backup can bring back queued jobs.  Empty = off.
#SABNZBD_NZB_BACKUP=nzb-backup

# Container engine socket mounted into wranglarr (restores + updates).
# Docker: /var/run/docker.sock.  Rootless Podman: /run/user/<uid>/podman/podman.sock
#DOCKER_SOCKET=/var/run/docker.sock
# wranglarr runs as PUID:PGID and reaches the socket through its group.
# init.sh fills this in: the socket's group id (stat -c %g /var/run/docker.sock),
# or 0 under rootless Podman and Docker Desktop.  See wiki/Security.md.
#DOCKER_GID=

# wranglarr's login (username + password, optional two-factor, passkeys).
# The first visit creates the account with a setup code from
# `docker compose logs wranglarr`.  off = no login at all: only behind a
# reverse proxy that asks for one itself.  See wiki/Login.md.
#WRANGLARR_AUTH=on

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17
POSTGRES_USER=arr
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port, only used if you uncomment ports: on the postgres service.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
RADARR_PORT=7878
SONARR_PORT=8989
LIDARR_PORT=8686
PROWLARR_PORT=9696
BAZARR_PORT=6767
# keep 8090 unless you also turn off Options → Web UI → Host header validation:
# qBittorrent refuses requests whose Host port differs from the one it listens on
QBITTORRENT_PORT=8090
SABNZBD_PORT=8085
NZBGET_PORT=6789
SEERR_PORT=5055
WRANGLARR_PORT=8787
# Browser path prefix, e.g. /wranglarr. The proxy passes it through unchanged.
# Bare routes stay available for healthchecks, webhooks and AuthTunnel.
WRANGLARR_URL_BASE=

# This machine's IP address on your network (not a domain name), for wranglarr's
# links and the reverse proxy config. Found by setup or ./scripts/init.sh: change
# it only if this .env goes to another machine (blank: init.sh finds it again).
HOST_IP=

# Reverse proxy addresses trusted for X-Forwarded-For/Host/Proto (exact IPs,
# comma-separated). Use the proxy's source IP as seen inside wranglarr.
# Keep wranglarr's port private to those proxies when trusting forwarded headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# wranglarr -> gluetun control server (shared VPN).  Generate: openssl rand -hex 16
GLUETUN_API_KEY=
# App logins (wiki/App-Logins.md). Applied by ./scripts/init.sh; to change them
# later: wranglarr-setup --auth, then ./scripts/init.sh --auth.
#   apps   = this login in every app (qBittorrent and NZBGet below too)
#   tunnel = AuthTunnel: the apps have no login of their own, wranglarr-gate
#            lets you in when you're signed in to wranglarr
#   manual = leave the apps' logins alone (the default when this is unset)
APPS_AUTH=apps
APPS_LOGIN_USER=admin
APPS_LOGIN_PASSWORD=
# enabled = ask everywhere; disabledForLocalAddresses = not on the local network
# (arrs and Prowlarr; behind a proxy or Docker's port forwarding that can mean never)
APPS_AUTH_REQUIRED=enabled
# tunnel, behind a reverse proxy: your domain and wranglarr's name on the proxy (never
# this machine's IP: by IP and port the apps work with these blank)
AUTH_COOKIE_DOMAIN=
AUTH_LOGIN_URL=
#GATE_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.27-alpine

# qBittorrent web UI login. wranglarr and the arrs log in with it. apps/tunnel:
# init writes it into qBittorrent.conf (apps: make it the login above).
# manual: qBittorrent prints a temporary password on first start (logs); set a
# permanent one in its UI and copy it here.
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=

# NZBGet web login; the image applies it at every start (apps: the login above)
NZBGET_USER=nzbget
NZBGET_PASS=change-me

# Image overrides (leave blank for the defaults in compose.yaml / compose.vpn-per-app.yaml)
#RADARR_IMAGE=
#SONARR_IMAGE=
#LIDARR_IMAGE=
#PROWLARR_IMAGE=
#BAZARR_IMAGE=
#QBITTORRENT_IMAGE=
#SABNZBD_IMAGE=
#NZBGET_IMAGE=
#SEERR_IMAGE=

# ---------------------------------------------------------------------------
# VPN, shared tunnel (compose.vpn.yaml): one gluetun container runs WireGuard
# and the apps in the tunnel are attached to its network.  Enable with one of the
# COMPOSE_FILE lines at the top.
# Variables mirror github.com/qdm12/gluetun-wiki (setup/providers, setup/options).
# ---------------------------------------------------------------------------
# custom = your own WireGuard peer (keys below, or drop a wg0.conf at
# appdata/vpn/wireguard/wg0.conf and leave the keys blank).
# Or a named provider: mullvad, protonvpn, "private internet access", airvpn,
# ivpn, nordvpn, surfshark, windscribe, ...
VPN_SERVICE_PROVIDER=custom
# wireguard (default) or openvpn (legacy; every provider supports it)
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=
# custom provider only (must be an IP, not a hostname):
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_MTU=1320
# named providers: pick servers
SERVER_COUNTRIES=
SERVER_CITIES=
SERVER_HOSTNAMES=
SERVER_REGIONS=
# PIA / ProtonVPN account credentials (used for WireGuard too)
VPN_USER=
VPN_PASSWORD=
VPN_PORT_FORWARDING=off
VPN_PORT_FORWARDING_PROVIDER=
# on = pick only servers that can forward a port (PIA, ProtonVPN's P2P servers)
VPN_PORT_FORWARD_ONLY=
# OpenVPN only.  For your own .ovpn: VPN_SERVICE_PROVIDER=custom, put the file at
# appdata/vpn/custom.conf (remote = an IP, certs beside it referenced as
# /gluetun/ca.crt ...) and set OPENVPN_CUSTOM_CONFIG=/gluetun/custom.conf
OPENVPN_PROTOCOL=udp
OPENVPN_CUSTOM_CONFIG=
OPENVPN_CIPHERS=
# LAN subnets the arrs may reach directly (NAS, a download client on another
# box).  Blank = only the Docker network and the tunnel.
VPN_LAN_NETWORK=
DNS_UPSTREAM_RESOLVER_TYPE=dot
DNS_UPSTREAM_RESOLVERS=cloudflare
BLOCK_MALICIOUS=on
HEALTH_VPN_DURATION_INITIAL=30s
UPDATER_PERIOD=24h
#GLUETUN_IMAGE=qmcgaw/gluetun:v3.41.3

# ---------------------------------------------------------------------------
# VPN, per-app tunnels (compose.vpn-per-app.yaml, hotio images).  Alternative
# to the shared tunnel above when only some apps should use the VPN.
#   COMPOSE_FILE=compose.yaml:compose.vpn-per-app.yaml
# Variables mirror hotio.dev/containers.  Each app needs its own WireGuard
# peer at appdata/<app>/wireguard/wg0.conf (generic/proton) or PIA creds.
# ---------------------------------------------------------------------------
RADARR_VPN=false
SONARR_VPN=false
LIDARR_VPN=false
PROWLARR_VPN=false
BAZARR_VPN=false
QBITTORRENT_VPN=false
SABNZBD_VPN=false
NZBGET_VPN=false
VPN_PROVIDER=generic
VPN_CONF=wg0
VPN_HEALTHCHECK_ENABLED=true
VPN_AUTO_PORT_FORWARD=false
VPN_EXPOSE_PORTS_ON_LAN=
VPN_PORT_REDIRECTS=
VPN_NAMESERVERS=
VPN_INTERFACE_PREFIXES=
VPN_LAN_LEAK_ENABLED=false
VPN_PIA_USER=
VPN_PIA_PASS=
VPN_PIA_PREFERRED_REGION=
VPN_PIA_DIP_TOKEN=
VPN_PIA_PORT_FORWARD_PERSIST=false
PRIVOXY_ENABLED=false
UNBOUND_ENABLED=false
UNBOUND_NAMESERVERS=
