#!/bin/sh
# Fake Postgres tool for the black-box tests (tests/README.md): logs the call to
# $FAKE_PG_LOG and, for `-f <file>`, writes a small fake dump there.
out=""; db=""
while [ $# -gt 0 ]; do case "$1" in -f) out=$2; shift;; -d) db=$2; shift;; -*) ;; *) db=$1;; esac; shift; done
echo "$(date) $0 $db ${out:-}" >> "${FAKE_PG_LOG:-/dev/null}"
[ -n "$out" ] && echo "fake dump of $db" > "$out"
exit 0
